# Dev: VITE_API_URL is intentionally empty — Vite proxy forwards /api, /admin, /auth, /delivery to localhost:8787
VITE_API_URL=
# Storefront base URL — shown to store owners as their public store URL
VITE_STOREFRONT_URL=http://localhost:5173
# Timezone for all date/time display (IANA timezone name)
VITE_DEFAULT_TIMEZONE=Africa/Nairobi
