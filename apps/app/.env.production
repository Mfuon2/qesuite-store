# ─── apps/app deployed at go.qesuite.com ──────────────────────────────────
# Serves: store owner dashboard  /dashboard
#         admin panel             /admin
#         rider PWA               /rider

# Worker API URL — update after `wrangler deploy`
# e.g. https://qesuite-worker-api.<your-cf-subdomain>.workers.dev
#   OR custom domain: https://api.qesuite.com
VITE_API_URL=https://qesuite-worker-api.leemfo.workers.dev

# Customer-facing storefront URL (different Pages project at store.qesuite.com)
# Shown to store owners so they can share their store link
VITE_STOREFRONT_URL=https://store.qesuite.com
# Timezone for all date/time display (IANA timezone name)
VITE_DEFAULT_TIMEZONE=Africa/Nairobi
